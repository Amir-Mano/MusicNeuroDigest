# Copy this file to .env and fill in real values. .env is gitignored.

# Gmail account used to send the digest (needs 2FA + an App Password, not your normal password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_APP_PASSWORD=

# Where the digest gets sent. Defaults to EMAIL_ADDRESS if left blank.
EMAIL_TO=your_email@gmail.com

# Optional: NCBI API key, only needed if you start running this much more than weekly.
NCBI_API_KEY=
